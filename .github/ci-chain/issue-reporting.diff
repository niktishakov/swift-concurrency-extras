diff --git a/Sources/IssueReporting/Internal/Locking.swift b/Sources/IssueReporting/Internal/Locking.swift
new file mode 100644
index 0000000..5e84e0d
--- /dev/null
+++ b/Sources/IssueReporting/Internal/Locking.swift
@@ -0,0 +1,67 @@
+#if canImport(Darwin) || os(WASI)
+  import Foundation
+
+  typealias _Lock = NSLock
+  typealias _RecursiveLock = NSRecursiveLock
+
+#else
+  #if canImport(Glibc)
+    import Glibc
+  #elseif canImport(Musl)
+    import Musl
+  #elseif canImport(Android)
+    import Android
+  #elseif os(Windows)
+    import WinSDK
+  #endif
+  /// Used where `NSLock` is used on Darwin. A recursive lock also works as a plain one.
+  typealias _Lock = _RecursiveLock
+
+  /// A recursive lock, like `NSRecursiveLock`, that does not depend on Foundation.
+  final class _RecursiveLock: @unchecked Sendable {
+    #if os(Windows)
+      private let mutex = UnsafeMutablePointer<CRITICAL_SECTION>.allocate(capacity: 1)
+    #else
+      private let mutex = UnsafeMutablePointer<pthread_mutex_t>.allocate(capacity: 1)
+    #endif
+
+    init() {
+      #if os(Windows)
+        InitializeCriticalSection(self.mutex)
+      #else
+        var attributes = pthread_mutexattr_t()
+        pthread_mutexattr_init(&attributes)
+        pthread_mutexattr_settype(&attributes, Int32(PTHREAD_MUTEX_RECURSIVE))
+        pthread_mutex_init(self.mutex, &attributes)
+        pthread_mutexattr_destroy(&attributes)
+      #endif
+    }
+
+    deinit {
+      #if os(Windows)
+        DeleteCriticalSection(self.mutex)
+        self.mutex.deallocate()
+      #else
+        pthread_mutex_destroy(self.mutex)
+        self.mutex.deallocate()
+      #endif
+    }
+
+    func lock() {
+      #if os(Windows)
+        EnterCriticalSection(self.mutex)
+      #else
+        pthread_mutex_lock(self.mutex)
+      #endif
+    }
+
+    func unlock() {
+      #if os(Windows)
+        LeaveCriticalSection(self.mutex)
+      #else
+        pthread_mutex_unlock(self.mutex)
+      #endif
+    }
+
+  }
+#endif
