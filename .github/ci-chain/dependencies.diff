-    .replacingOccurrences(
-      of: #"\(unknown context at \$[[:xdigit:]]+\)\."#,
-      with: "",
-      options: .regularExpression
-    )
-  return sanitizedName
+  return name.removingUnknownContexts()
+}
+
+extension String {
+  /// Removes every `(unknown context at $<hex>).` from a type name.
+  fileprivate func removingUnknownContexts() -> String {
+    let prefix = "(unknown context at $"
+    var result = ""
+    var rest = self[...]
+    while !rest.isEmpty {
+      if rest.hasPrefix(prefix) {
+        let afterPrefix = rest.dropFirst(prefix.count)
+        let hex = afterPrefix.prefix(while: \.isHexDigit)
+        let afterHex = afterPrefix[hex.endIndex...]
+        if !hex.isEmpty, afterHex.hasPrefix(").") {
+          rest = afterHex.dropFirst(2)
+          continue
+        }
+      }
+      result.append(rest.removeFirst())
+    }
+    return result
+  }
 }
